DATABASE_URL=https://supabase/host/capataz

WHATSAPP_VERIFY_TOKEN=mi_token_secreto
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
# App Secret (Meta → App settings → Basic). Valida la firma del webhook.
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx

R2_ACCOUNT_ID=xxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_BUCKET_NAME=capataz-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Firma los tokens de login. OBLIGATORIA en Railway (la app no arranca sin ella).
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# UUID de la empresa mono-tenant (ejecutar seed.py para obtenerlo)
COMPANY_ID=00000000-0000-0000-0000-000000000001

# Zona horaria y jornada (check-in después de 08:10 = tarde; domingo = descanso)
TIMEZONE=America/Merida
WORKDAY_START=08:00
LATE_TOLERANCE_MINUTES=10
REST_WEEKDAYS=6

# Verificación de presencia: al checar, el bot pide la ubicación y la compara con
# la obra (radio en metros). Las coordenadas se borran a los N días; solo queda
# "en obra" / "a X km". Fotos casi idénticas a una de los últimos N días = repetidas.
CHECKIN_ASK_LOCATION=true
GEOFENCE_METERS=300
LOCATION_RETENTION_DAYS=90
LOCATION_PURGE_TIME=03:30
DUPLICATE_PHOTO_DAYS=60

# Recordatorios a trabajadores (8:30 llegada, 15:00 avance). Sin plantilla solo
# llegan a quien escribió en las últimas 24 h (gratis); false = apagados.
PROACTIVE_ENABLED=true

# Plantillas de WhatsApp (ver docs/plantillas_whatsapp.md). Respaldo para quien no
# ha escrito en 24 h. El resumen al dueño sí la necesita siempre.
WA_TEMPLATE_LANG=es_MX
WA_TEMPLATE_CHECKIN_REMINDER=
WA_TEMPLATE_JOB_PROGRESS=
WA_TEMPLATE_JOB_ASSIGNED=
WA_TEMPLATE_DAILY_SUMMARY=
CHECKIN_REMINDER_TIME=08:30
JOB_PROGRESS_TIME=15:00
DAILY_SUMMARY_TIME=18:00
